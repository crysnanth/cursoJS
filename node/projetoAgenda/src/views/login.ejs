<%- include('./includes/head') %> <%- include('./includes/nav') %>

<div class="container">
    <div class="row">
        <div class="col-lg-2"></div>

        <div class="col-lg-8 mt-3">
            <h1 class="text-center">Criar Conta ou Entrar</h1>
            <p class="text-center">
                Faça login ou se registre preenchendo os dados
            </p>

            <%- include('includes/messages') %>

            <div class="row">
                <div class="col-lg">
                    <h4 class="text-center">Faça login</h4>
                    <form action="/login/login" method="post" id="form-login">
                        <input
                            type="hidden"
                            name="_csrf"
                            value="<%= csrfToken %>"
                        />
                        <div class="mb-3">
                            <label for="exampleInputEmail1" class="form-label"
                                >Email</label
                            >
                            <input
                                type="email"
                                class="form-control"
                                id="exampleInputEmail1"
                                aria-describedby="emailHelp"
                                name="email"
                            />
                        </div>
                        <div class="mb-3">
                            <label
                                for="exampleInputPassword1"
                                class="form-label"
                                >Senha</label
                            >
                            <input
                                type="password"
                                class="form-control"
                                id="exampleInputPassword1"
                                name="password"
                            />
                        </div>
                        <button type="submit" class="btn btn-primary">
                            Entrar
                        </button>
                    </form>
                </div>
                <div class="col-lg">
                    <h4 class="text-center">Registre-se</h4>
                    <form action="/login/register" method="post" id="form-register">
                        <input
                            type="hidden"
                            name="_csrf"
                            value="<%= csrfToken %>"
                        />
                        <div class="mb-3">
                            <label for="exampleInputEmail1" class="form-label"
                                >Email</label
                            >
                            <input
                                type="email"
                                class="form-control"
                                id="exampleInputEmail1"
                                aria-describedby="emailHelp"
                                name="email"
                            />
                        </div>
                        <div class="mb-3">
                            <label
                                for="exampleInputPassword1"
                                class="form-label"
                                >Senha</label
                            >
                            <input
                                type="password"
                                class="form-control"
                                id="exampleInputPassword1"
                                name="password"
                            />
                        </div>
                        <button type="submit" class="btn btn-primary">
                            Criar Conta
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-2"></div>
    </div>
</div>

<%- include('./includes/footer') %>
