<% if (errors.length > 0) { %>
<div class="row">
    <div class="col">
        <div class="alert alert-danger">
            <% for (const error of errors) { %>
                <%= error %> <br>
            <% } %>
        </div>
    </div>
</div>
<% } %>

<% if (success.length > 0) { %>
<div class="row">
    <div class="col">
        <div class="alert alert-success">
            <% for (const succs of success) { %>
                <%= succs %> <br>
            <% } %>
        </div>
    </div>
</div>
<% } %>